{
    "name": "notification/homer",
    "description": "Homer notifications service",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.0",
        "openspout/openspout": "^5.15",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "scripts": {
        "post-autoload-dump": ["@php artisan package:discover --ansi"]
